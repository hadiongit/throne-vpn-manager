class ManagerError(RuntimeError):
    pass


def now_text() -> str:
    return dt.datetime.now().astimezone().strftime("%Y-%m-%d %H:%M:%S %Z")


def init_dirs() -> None:
    global LOG_FILE
    for path in (CONFIG_DIR, STATE_DIR, TIMEZONE_STATE_DIR, LOG_DIR):
        path.mkdir(parents=True, exist_ok=True)
        try:
            path.chmod(0o700)
        except OSError:
            pass
    LOG_FILE = LOG_DIR / (dt.datetime.now().strftime("%Y%m%d-%H%M%S") + ".log")
    LOG_FILE.touch(mode=0o600, exist_ok=True)
    try:
        LOG_FILE.chmod(0o600)
    except OSError:
        pass


def log(message: str = "", level: str = "INFO") -> None:
    print(message, flush=True)
    if LOG_FILE:
        try:
            with LOG_FILE.open("a", encoding="utf-8") as f:
                f.write(f"[{now_text()}] [{level}] {message}\n")
        except OSError:
            pass


def section(title: str) -> None:
    log("\n" + "=" * 68)
    log(title)
    log("=" * 68)


def run_cmd(
    argv: list[str], *, timeout: int = 60,
    env: dict[str, str] | None = None, show_output: bool = True,
) -> subprocess.CompletedProcess[str]:
    try:
        result = subprocess.run(
            argv, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            timeout=timeout, env=env, check=False,
        )
    except subprocess.TimeoutExpired as exc:
        output = exc.stdout or ""
        if isinstance(output, bytes):
            output = output.decode("utf-8", "replace")
        return subprocess.CompletedProcess(argv, 124, output + "\nCommand timed out.")
    except FileNotFoundError:
        return subprocess.CompletedProcess(argv, 127, f"Command not found: {argv[0]}")

    output = (result.stdout or "").strip()
    if output and show_output:
        for line in output.splitlines():
            log("  " + line)
    elif output and LOG_FILE:
        with LOG_FILE.open("a", encoding="utf-8") as f:
            f.write(f"[{now_text()}] [CMD] {' '.join(argv)}\n{output}\n")
    return result


def load_config() -> dict[str, Any]:
    defaults: dict[str, Any] = {
        "group_id": None,
        "group_name": None,
        "tun_interface": DEFAULT_TUN_IFACE,
        "local_proxy_url": DEFAULT_LOCAL_PROXY_URL,
        "max_profile_attempts": 20,
        "latency_timeout_minutes": 20,
        "speed_test_top_n": 1,
        "post_connect_grace_seconds": 8,
        "public_ip_wait_seconds": 50,
    }
    if not CONFIG_FILE.exists():
        return defaults
    try:
        data = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            raise ValueError("Configuration is not an object")
        defaults.update(data)
        return defaults
    except Exception as exc:
        raise ManagerError(f"The configuration file is corrupted or unreadable: {CONFIG_FILE}\n{exc}")


def save_config(config: dict[str, Any]) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    temp = CONFIG_FILE.with_suffix(".tmp")
    temp.write_text(json.dumps(config, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    temp.chmod(0o600)
    os.replace(temp, CONFIG_FILE)


def write_session(data: dict[str, Any]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    temp = SESSION_FILE.with_suffix(".tmp")
    temp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    temp.chmod(0o600)
    os.replace(temp, SESSION_FILE)


def read_session() -> dict[str, Any] | None:
    if not SESSION_FILE.is_file():
        return None
    try:
        data = json.loads(SESSION_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else None
    except Exception as exc:
        raise ManagerError(f"The session state file is unreadable: {SESSION_FILE}\n{exc}")


def clear_session() -> None:
    try:
        SESSION_FILE.unlink(missing_ok=True)
    except OSError as exc:
        raise ManagerError(f"The connection was stopped, but removing the session state file failed: {exc}")


def mark_session_verified() -> None:
    """Mark the bootstrap complete so future Start calls never restart the live TUN."""
    session = read_session()
    if not session:
        raise ManagerError("The pinned session file was not found; cannot mark the session as verified.")
    session["phase"] = "verified"
    session["verified_at"] = now_text()
    write_session(session)


def input_prefilled(prompt: str, default: str) -> str:
    try:
        readline.set_startup_hook(lambda: readline.insert_text(default))
        return input(prompt)
    finally:
        readline.set_startup_hook(None)


def read_key() -> str:
    if not sys.stdin.isatty():
        return input("Selection (number): ").strip()
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        ch = sys.stdin.read(1)
        if ch == "\x1b":
            return ch + sys.stdin.read(2)
        if ch in ("\r", "\n"):
            return "ENTER"
        return ch
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def choose_menu(title: str, options: list[str]) -> int:
    selected = 0
    while True:
        if sys.stdout.isatty():
            print("\033[2J\033[H", end="")
        print(title)
        print("-" * len(title))
        for i, option in enumerate(options):
            marker = "❯" if i == selected else " "
            print(f"\033[1;32m {marker} {option}\033[0m" if i == selected else f"   {option}")
        print("\nUse the Up/Down arrow keys and press Enter to select; press q to quit.")
        key = read_key()
        if key in ("\x1b[A", "\x1bOA"):
            selected = (selected - 1) % len(options)
        elif key in ("\x1b[B", "\x1bOB"):
            selected = (selected + 1) % len(options)
        elif key == "ENTER":
            return selected
        elif key.lower() == "q":
            return len(options) - 1
        elif key.isdigit() and key:
            n = int(key) - 1
            if 0 <= n < len(options):
                return n


class ThroneClient:
    def __init__(self, *, allow_key_prompt: bool = True) -> None:
        self.addr = os.environ.get("THRONE_ADDR", DEFAULT_THRONE_ADDR)
        self.env = os.environ.copy()
        self.key_file: Path | None = None
        env_key_file = self.env.get("THRONE_KEY_FILE", "").strip()
        env_key = self.env.get("THRONE_KEY", "").strip()
        if env_key:
            self.env["THRONE_KEY"] = env_key
        else:
            candidate = Path(env_key_file).expanduser() if env_key_file else KEY_DEFAULT
            if candidate.is_file() and os.access(candidate, os.R_OK):
                self.key_file = candidate
            elif allow_key_prompt:
                self.configure_key()
            else:
                raise ManagerError(f"Throne API key file not found: {candidate}")

    def configure_key(self) -> None:
        log("The API key is unavailable. In Throne, open Settings → Integration Settings → Throne API and select Copy for scripts.")
        secret = getpass.getpass("Throne API key: ").strip()
        if secret.startswith("THRONE_KEY="):
            secret = secret.split("=", 1)[1].strip().strip("\"'")
        if len(secret) < 32:
            raise ManagerError("The provided API key is too short. Copy the API key again.")
        KEY_DEFAULT.parent.mkdir(parents=True, exist_ok=True)
        KEY_DEFAULT.parent.chmod(0o700)
        KEY_DEFAULT.write_text(secret + "\n", encoding="utf-8")
        KEY_DEFAULT.chmod(0o600)
        self.key_file = KEY_DEFAULT
        log(f"API key saved to the private path: {KEY_DEFAULT}")

    def command(self, args: list[str], *, timeout: int = 60, json_output: bool = False,
                show_output: bool = True) -> subprocess.CompletedProcess[str]:
        base = ["thronectl", "--addr", self.addr]
        if self.key_file:
            base += ["--key-file", str(self.key_file)]
        if json_output:
            base += ["--json"]
        return run_cmd(base + args, timeout=timeout, env=self.env, show_output=show_output)

    def json_api(self, method: str, path: str, *query: str) -> dict[str, Any]:
        result = self.command(["call", method, path, *query], timeout=30,
                              json_output=True, show_output=False)
        if result.returncode != 0:
            raise ManagerError(f"Throne API request failed ({method} {path}):\n{result.stdout.strip()}")
        try:
            data = json.loads(result.stdout)
        except json.JSONDecodeError as exc:
            raise ManagerError(f"The API response is unreadable ({method} {path}): {exc}\n{result.stdout[:1000]}")
        if not isinstance(data, dict):
            raise ManagerError(f"Unexpected API response structure ({method} {path}).")
        return data


def timedatectl_timezone() -> str:
    result = run_cmd(["timedatectl", "show", "-p", "Timezone", "--value"], timeout=10, show_output=False)
    if result.returncode != 0:
        raise ManagerError("Failed to read the current timezone using timedatectl.")
    return result.stdout.strip()


def valid_timezone(zone: str) -> bool:
    result = run_cmd(["timedatectl", "list-timezones"], timeout=20, show_output=False)
    return result.returncode == 0 and zone in set(result.stdout.splitlines())


def ensure_original_timezone() -> str:
    if ORIGINAL_TZ_FILE.is_file():
        zone = ORIGINAL_TZ_FILE.read_text(encoding="utf-8").strip()
        if not zone or not valid_timezone(zone):
            raise ManagerError(f"The saved original timezone is invalid: {zone!r}\n{ORIGINAL_TZ_FILE}")
        return zone
    section("Save the system’s original timezone")
    current = timedatectl_timezone()
    default = "Asia/Tehran" if valid_timezone("Asia/Tehran") else current
    log(f"Current system timezone: {current}")
    log("Enter the original timezone. The suggested value is Asia/Tehran; you can edit it.")
    zone = input_prefilled("Original timezone: ", default).strip() or default
    if not valid_timezone(zone):
        raise ManagerError(f"Invalid timezone: {zone}")
    ORIGINAL_TZ_FILE.parent.mkdir(parents=True, exist_ok=True)
    temp = ORIGINAL_TZ_FILE.with_suffix(".tmp")
    temp.write_text(zone + "\n", encoding="utf-8")
    temp.chmod(0o600)
    os.replace(temp, ORIGINAL_TZ_FILE)
    log(f"Original timezone saved: {zone}")
    return zone


def restore_original_timezone(*, required: bool = False) -> bool:
    if not ORIGINAL_TZ_FILE.is_file():
        message = "The original timezone has not been saved; automatic restoration is unavailable."
        if required:
            raise ManagerError(message)
        log(message, "WARN")
        return False
    zone = ORIGINAL_TZ_FILE.read_text(encoding="utf-8").strip()
    if not valid_timezone(zone):
        message = f"The saved original timezone is invalid: {zone!r}"
        if required:
            raise ManagerError(message)
        log(message, "ERROR")
        return False
    current = timedatectl_timezone()
    if current != zone:
        result = run_cmd(["sudo", "timedatectl", "set-timezone", zone], timeout=120)
        if result.returncode != 0:
            if required:
                raise ManagerError("Failed to restore the original timezone.")
            log("Failed to restore the original timezone.", "ERROR")
            return False
    final = timedatectl_timezone()
    if final != zone:
        if required:
            raise ManagerError(f"Final timezone verification failed; current value is {final}.")
        log(f"Final timezone verification failed; current value is {final}.", "ERROR")
        return False
    log(f"Original timezone restored: {zone}")
    return True


def get_status(client: ThroneClient) -> dict[str, Any]:
    return client.json_api("GET", "/v1/status")


def get_settings(client: ThroneClient) -> dict[str, Any]:
    data = client.json_api("GET", "/v1/settings")
    settings = data.get("settings")
    if not isinstance(settings, dict):
        raise ManagerError("The Throne settings structure is invalid.")
    return settings


def get_groups(client: ThroneClient) -> list[dict[str, Any]]:
    data = client.json_api("GET", "/v1/groups")
    return [g for g in data.get("groups", []) if isinstance(g, dict)]


def get_profiles(client: ThroneClient, group_id: int | None = None) -> list[dict[str, Any]]:
    query = [f"group={group_id}"] if group_id is not None else []
    data = client.json_api("GET", "/v1/profiles", *query)
    return [p for p in data.get("profiles", []) if isinstance(p, dict)]


def active_profile(status: dict[str, Any]) -> dict[str, Any] | None:
    profile = status.get("profile")
    if isinstance(profile, dict) and profile.get("id") is not None:
        return profile
    return None


def wait_status_idle(client: ThroneClient, timeout: int = 30) -> dict[str, Any]:
    deadline = time.monotonic() + timeout
    last: dict[str, Any] = {}
    while time.monotonic() < deadline:
        last = get_status(client)
        if last.get("state") == "idle" and active_profile(last) is None:
            return last
        time.sleep(1)
    return last


def wait_stably_idle(client: ThroneClient, *, timeout: int = 25, stable_seconds: int = 4) -> dict[str, Any] | None:
    """Require IDLE with no active profile continuously before another startup candidate is tried."""
    deadline = time.monotonic() + timeout
    stable_since: float | None = None
    last: dict[str, Any] = {}
    while time.monotonic() < deadline:
        last = get_status(client)
        idle = last.get("state") == "idle" and active_profile(last) is None
        if idle:
            if stable_since is None:
                stable_since = time.monotonic()
            elif time.monotonic() - stable_since >= stable_seconds:
                return last
        else:
            stable_since = None
        time.sleep(1)
    return None


def wait_kill_switch_armed(client: ThroneClient, timeout: int = 45) -> tuple[bool, str]:
    deadline = time.monotonic() + timeout
    last_state, last_error = "unknown", ""
    while time.monotonic() < deadline:
        status = get_status(client)
        last_state = str(status.get("kill_switch", "unknown")).lower()
        last_error = str(status.get("kill_switch_error") or "")
        if last_state == "armed":
            return True, ""
        if last_state == "failed":
            return False, last_error or "Throne reported that the Kill Switch failed."
        time.sleep(1.5)
    return False, f"Kill Switch did not reach the armed state within {timeout} seconds (state: {last_state}; error: {last_error or 'no details'})."


def set_kill_switch(client: ThroneClient, enabled: bool) -> None:
    result = client.command(["settings", "set", f"kill_switch={'true' if enabled else 'false'}"], timeout=90)
    if result.returncode != 0:
        raise ManagerError(f"Failed to set Kill Switch to {'ON' if enabled else 'OFF'}.\n{result.stdout.strip()}")


def ensure_original_timezone_is_saved_for_stop() -> str | None:
    if not ORIGINAL_TZ_FILE.is_file():
        log("The original timezone is not saved. Network cleanup will continue, but the timezone cannot be restored automatically.", "WARN")
        return None
    zone = ORIGINAL_TZ_FILE.read_text(encoding="utf-8").strip()
    if not valid_timezone(zone):
        log(f"The saved original timezone is invalid: {zone!r}", "ERROR")
        return None
    return zone


def choose_group(client: ThroneClient, config: dict[str, Any], force: bool = False) -> int:
    groups = [g for g in get_groups(client) if g.get("subscription") and not g.get("archived")]
    if not groups:
        raise ManagerError("No active subscription groups were found in Throne.")
    saved_id = config.get("group_id")
    if not force and saved_id is not None:
        for group in groups:
            if int(group.get("id", -1)) == int(saved_id):
                config["group_name"] = group.get("name", "")
                return int(saved_id)
    print("\nSelect the subscription group whose profiles should be evaluated for server selection:")
    for index, group in enumerate(groups, 1):
        print(f"  {index}. {group.get('name', 'Unnamed')} | {group.get('profile_count', 0)} profiles | ID {group.get('id')}")
    while True:
        raw = input("Group number: ").strip()
        if raw.isdigit() and 1 <= int(raw) <= len(groups):
            selected = groups[int(raw) - 1]
            config["group_id"] = int(selected["id"])
            config["group_name"] = selected.get("name", "")
            save_config(config)
            return int(selected["id"])
        log("Invalid selection.", "WARN")


def profile_type_by_id(client: ThroneClient, profile_id: int, known: dict[str, Any] | None = None) -> str:
    if known and known.get("type"):
        return str(known.get("type"))
    for profile in get_profiles(client):
        if int(profile.get("id", -1)) == profile_id:
            return str(profile.get("type", "unknown"))
    return "unknown"


def is_dynamic_selector(profile_type: str) -> bool:
    value = profile_type.lower().replace("_", "").replace("-", "")
    return "selector" in value or value in {"urltest", "auto"}


def profile_candidates(profiles: list[dict[str, Any]], limit: int) -> list[dict[str, Any]]:
    static = []
    for p in profiles:
        if p.get("id") is None or is_dynamic_selector(str(p.get("type", ""))):
            continue
        static.append(p)

    def rank(p: dict[str, Any]) -> tuple[int, int, str]:
        latency = int(p.get("latency_ms", 0) or 0)
        if latency > 0:
            return (0, latency, str(p.get("name", "")))
        if latency == -2:
            return (1, 0, str(p.get("name", "")))
        if latency == 0:
            return (2, 0, str(p.get("name", "")))
        return (3, 0, str(p.get("name", "")))

    static.sort(key=rank)
    return static[:max(1, limit)]


def tun_interface_up(iface: str) -> bool:
    if not Path("/sys/class/net", iface).exists():
        return False
    result = run_cmd(["ip", "-o", "link", "show", "dev", iface], timeout=10, show_output=False)
    return result.returncode == 0 and bool(re.search(r"<[^>]*\bUP\b[^>]*>", result.stdout))


def resolve_endpoints_before_vpn() -> None:
    """Resolve check/GeoIP hosts while the normal network is still available.

    The resulting addresses let curl use --resolve after TUN and Kill Switch
    are enabled, avoiding a dependency on system DNS during VPN bootstrap.
    """
    PRE_RESOLVED.clear()
    hosts = [urlsplit(url).hostname for url in (*IP_CHECK_ENDPOINTS, *GEO_ENDPOINTS)]
    for host in dict.fromkeys(h for h in hosts if h):
        result = run_cmd(["getent", "ahostsv4", host], timeout=7, show_output=False)
        addresses: list[str] = []
        if result.returncode == 0:
            for line in result.stdout.splitlines():
                fields = line.split()
                if not fields:
                    continue
                try:
                    ip = ipaddress.ip_address(fields[0])
                    if ip.version == 4 and ip.is_global and str(ip) not in addresses:
                        addresses.append(str(ip))
                except ValueError:
                    continue
        PRE_RESOLVED[host] = addresses[:4]
        if addresses:
            log(f"Pre-VPN DNS for {host}: {', '.join(addresses[:4])}")
        else:
            log(f"Pre-VPN DNS for {host} could not be resolved; DNS/proxy fallbacks will be tried later.", "WARN")


def _curl_text(
    url: str, *, proxy_url: str | None = None, headers: list[str] | None = None,
    connect_timeout: int = 5, max_time: int = 8, retries: int = 0,
    resolve_ip: str | None = None,
) -> subprocess.CompletedProcess[str]:
    """Fetch a small response. resolve_ip bypasses local DNS for direct TUN tests."""
    argv = [
        "curl", "-4", "-fsS", "--connect-timeout", str(connect_timeout),
        "--max-time", str(max_time),
    ]
    if retries > 0:
        argv += ["--retry", str(retries), "--retry-all-errors", "--retry-delay", "1"]
    if proxy_url:
        argv += ["--proxy", proxy_url, "--noproxy", ""]
    else:
        argv += ["--noproxy", "*"]
        host = urlsplit(url).hostname
        if resolve_ip and host:
            argv += ["--resolve", f"{host}:443:{resolve_ip}"]
    for header in headers or []:
        argv += ["-H", header]
    argv.append(url)
    return run_cmd(argv, timeout=max_time + connect_timeout + 5, show_output=False)


def _parse_global_ip(output: str) -> str | None:
    value = output.strip().splitlines()[0].strip() if output.strip() else ""
    try:
        parsed = ipaddress.ip_address(value)
        return str(parsed) if parsed.is_global else None
    except ValueError:
        return None


def check_system_dns() -> bool:
    """Verify that normal hostname lookups work after the TUN DNS workaround."""
    deadline = time.monotonic() + 12
    last_error = ""
    while time.monotonic() < deadline:
        result = run_cmd(["getent", "ahostsv4", "example.com"], timeout=5, show_output=False)
        if result.returncode == 0 and result.stdout.strip():
            log("The system DNS check succeeded after connecting.")
            return True
        last_error = (result.stdout or "DNS lookup failed").strip()[-160:]
        time.sleep(2)
    log(
        "Warning: The public IP is reachable through TUN, but normal system DNS resolution is still failing. "
        "Some applications may not be able to resolve domain names. Check the Remote DNS and Direct DNS settings in Throne. "
        f"Last error: {last_error}",
        "WARN",
    )
    return False


def public_ip(
    proxy_url: str | None = DEFAULT_LOCAL_PROXY_URL, *,
    client: ThroneClient | None = None, pinned_id: int | None = None,
    iface: str | None = None, wait_seconds: int = 50,
    grace_seconds: int = 8,
) -> str | None:
    """Verify actual system/TUN egress with warm-up, DNS pinning and bounded retries."""
    log(f"Waiting {grace_seconds} seconds after connecting for TUN and DNS routing to become ready...")
    time.sleep(max(0, grace_seconds))
    deadline = time.monotonic() + max(10, wait_seconds)
    round_no = 0
    last_proxy_ip: str | None = None
    while time.monotonic() < deadline:
        round_no += 1
        if client is not None and pinned_id is not None:
            profile, status = profile_running_now(client)
            if not profile or int(profile.get("id", -1)) != pinned_id or status.get("state") != "running":
                raise ManagerError(
                    f"The pinned profile state changed during network verification (ID {pinned_id}). "
                    "No profile switch will be attempted. Run --stop to end the session safely."
                )
            if str(status.get("kill_switch", "")).lower() != "armed":
                raise ManagerError("Kill Switch is no longer armed during public IP verification; the profile will not be changed.")
        if iface and not tun_interface_up(iface):
            log(f"Interface {iface} is not UP yet; waiting for TUN to become ready.", "WARN")
            time.sleep(3)
            continue

        log(f"Direct TUN egress check, attempt {round_no}...")
        for endpoint in IP_CHECK_ENDPOINTS:
            host = urlsplit(endpoint).hostname or ""
            addresses = PRE_RESOLVED.get(host, [])
            # Rotate through DNS answers between rounds to avoid one stale CDN edge.
            resolve_ip = addresses[(round_no - 1) % len(addresses)] if addresses else None
            suffix = f" (DNS-pinned: {resolve_ip})" if resolve_ip else " (system DNS)"
            log(f"Checking public IP through the direct system/TUN route: {endpoint}{suffix}")
            result = _curl_text(
                endpoint, connect_timeout=4, max_time=6, retries=0, resolve_ip=resolve_ip
            )
            if result.returncode == 0:
                value = _parse_global_ip(result.stdout)
                if value:
                    log(f"Public IP verified through the direct system/TUN route: {value}")
                    check_system_dns()
                    return value
                log(f"The direct route returned an invalid IP response: {result.stdout.strip()[:120] or 'empty response'}", "WARN")
            else:
                log(f"Direct request failed (exit={result.returncode}): {result.stdout.strip()[-180:]}", "WARN")

        # One diagnostic proxy check per round. It does not replace TUN proof.
        if proxy_url and round_no in (1, 3):
            endpoint = IP_CHECK_ENDPOINTS[0]
            log(f"Diagnostic check through the local Throne proxy: {endpoint}")
            result = _curl_text(endpoint, proxy_url=proxy_url, connect_timeout=4, max_time=6, retries=0)
            if result.returncode == 0:
                last_proxy_ip = _parse_global_ip(result.stdout)
                if last_proxy_ip:
                    log(f"The local proxy returned an egress IP: {last_proxy_ip}; this does not replace TUN verification.", "WARN")
            else:
                log(f"The local proxy also failed to respond: {result.stdout.strip()[-180:]}", "WARN")

        if time.monotonic() < deadline:
            time.sleep(4)

    if last_proxy_ip:
        log(f"The local proxy is working (IP={last_proxy_ip}), but the direct TUN route was not verified. Auto Redirect, TUN, or DNS may be misconfigured.", "ERROR")
    return None

def fetch_geo(ip_expected: str, proxy_url: str | None = DEFAULT_LOCAL_PROXY_URL) -> tuple[str, str, str, str] | None:
    routes: list[tuple[str, str | None]] = [("system/TUN", None)]
    if proxy_url:
        routes.append(("Throne local proxy", proxy_url))

    for provider_url in GEO_ENDPOINTS:
        provider = "IP Info" if "ip-info.com" in provider_url else "ipapi.is"
        host = urlsplit(provider_url).hostname or ""
        for route_name, proxy in routes:
            addresses = PRE_RESOLVED.get(host, []) if proxy is None else []
            attempts: list[str | None] = addresses[:3] if addresses else [None]
            for resolve_ip in attempts:
                route_suffix = f" DNS-pinned={resolve_ip}" if resolve_ip else ""
                log(f"Detecting location and timezone using {provider} via {route_name}{route_suffix} ...")
                result = _curl_text(
                    provider_url, proxy_url=proxy,
                    headers=["Accept: application/json", "User-Agent: vpn-manager/2.2"],
                    connect_timeout=5, max_time=10, retries=0, resolve_ip=resolve_ip,
                )
                if result.returncode != 0:
                    log(f"Service {provider} via {route_name} did not respond: {result.stdout.strip()[-180:]}", "WARN")
                    continue
                try:
                    data = json.loads(result.stdout)
                    got_ip = str(data.get("ip", "")).strip()
                    tz = data.get("timezone")
                    if isinstance(tz, dict):
                        tz = tz.get("id") or tz.get("name")
                    country = str(data.get("country_name") or data.get("country") or "Unknown")
                    city = str(data.get("city") or "Unknown")
                    tz = str(tz or "").strip()
                    if got_ip != ip_expected:
                        log(f"The IP returned by {provider} does not match the TUN egress IP; the response was rejected.", "WARN")
                        continue
                    ipaddress.ip_address(got_ip)
                    if not tz or not valid_timezone(tz):
                        log(f"A valid timezone was not returned by {provider}: {tz!r}", "WARN")
                        continue
                    log(f"Valid GeoIP data was returned by {provider} via {route_name}.")
                    return provider, country, city, tz
                except Exception as exc:
                    log(f"Response from {provider} was unusable: {exc}", "WARN")
    return None

def sync_timezone(ip: str, proxy_url: str | None = DEFAULT_LOCAL_PROXY_URL) -> tuple[str, str, str, str]:
    section("Timezone synchronization")
    geo = fetch_geo(ip, proxy_url)
    if not geo:
        raise ManagerError("The VPN remains connected to the pinned profile, but the GeoIP service did not return a valid timezone. The timezone was not changed.")
    provider, country, city, zone = geo
    current = timedatectl_timezone()
    log(f"VPN IP      : {ip}")
    log(f"Country     : {country}")
    log(f"City        : {city}")
    log(f"IP Timezone : {zone}")
    log(f"System TZ   : {current}")
    if current != zone:
        result = run_cmd(["sudo", "timedatectl", "set-timezone", zone], timeout=120)
        if result.returncode != 0:
            raise ManagerError("The VPN connection was preserved, but applying the timezone with sudo failed.")
    final_zone = timedatectl_timezone()
    if final_zone != zone:
        raise ManagerError(f"Expected timezone {zone}, but the system reported {final_zone}.")
    log(f"Timezone synchronized with the VPN: {zone}")
    return provider, country, city, zone


