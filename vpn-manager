        "phase": phase,
        "profile_id": int(profile["id"]),
        "profile_name": str(profile.get("name", f"Profile {profile['id']}")),
        "profile_type": str(profile.get("type", "unknown")),
        "group_id": group_id,
        "started_at": now_text(),
        "policy": "single-static-profile-no-failover",
        "tun_dns_refreshed": False,
    })


def profile_running_now(client: ThroneClient) -> tuple[dict[str, Any] | None, dict[str, Any]]:
    status = get_status(client)
    profile = active_profile(status)
    if profile:
        return profile, status
    if status.get("state") == "running":
        # Fallback for versions that omit the nested profile from status.
        for item in get_profiles(client):
            if item.get("running"):
                return item, status
    return None, status


def wait_for_profile_result(client: ThroneClient, requested_id: int, timeout: int = 20) -> tuple[str, dict[str, Any] | None, dict[str, Any]]:
    deadline = time.monotonic() + timeout
    last_status: dict[str, Any] = {}
    while time.monotonic() < deadline:
        profile, last_status = profile_running_now(client)
        state = str(last_status.get("state", "unknown"))
        if profile and state == "running":
            return "running", profile, last_status
        if state == "idle" and profile is None:
            return "idle", None, last_status
        time.sleep(1)
    profile, last_status = profile_running_now(client)
    state = str(last_status.get("state", "unknown"))
    if profile and state == "running":
        return "running", profile, last_status
    if state == "idle" and profile is None:
        return "idle", None, last_status
    return "pending", profile, last_status


def ensure_tun_on(client: ThroneClient, pinned_id: int | None, iface: str) -> None:
    status = get_status(client)
    if not bool(status.get("tun")):
        result = client.command(["tun", "on"], timeout=90)
        if result.returncode != 0:
            raise ManagerError("Failed to enable TUN. Check ThroneCore permissions and /dev/net/tun.\n" + result.stdout.strip())
    deadline = time.monotonic() + 35
    while time.monotonic() < deadline:
        status = get_status(client)
        current = active_profile(status)
        if pinned_id is not None and current and int(current.get("id", -1)) != pinned_id:
            raise ManagerError("The active profile ID changed after the TUN setting was modified. No other connection will be attempted; run vpn-manager --stop to restore normal operation.")
        if bool(status.get("tun")) and (pinned_id is None or (current and int(current.get("id", -1)) == pinned_id and status.get("state") == "running")):
            return
        time.sleep(1)
    if not bool(get_status(client).get("tun")):
        raise ManagerError("Throne did not report TUN as enabled after the tun on command.")
    if pinned_id is not None:
        raise ManagerError("The original profile could not be verified after enabling TUN. No replacement profile will be started.")


def activate_kill_switch(client: ThroneClient) -> None:
    settings = get_settings(client)
    if not bool(settings.get("kill_switch")):
        set_kill_switch(client, True)
    armed, error = wait_kill_switch_armed(client, timeout=50)
    if not armed:
        raise ManagerError("The profile remains connected and pinned, but Kill Switch did not become operational. No other VPN will be attempted. " + error)
    log("Kill Switch is confirmed operational (armed).")


def ensure_linux_auto_redirect(client: ThroneClient) -> None:
    """Auto Redirect is required for Linux TUN traffic interception.

    The setting is applied before TUN is enabled and before any profile runs.
    It is deliberately not changed while a profile is active.
    """
    if not sys.platform.startswith("linux"):
        return
    settings = get_settings(client)
    value = settings.get("tun_auto_redirect")
    if value is None:
        raise ManagerError(
            "The Throne API did not return tun_auto_redirect. To avoid enabling Kill Switch without a reliable TUN route, "
            "the connection was not started. Check the Throne/API version."
        )
    if bool(value):
        log("Tun Auto Redirect: ON (verified).")
        return

    status = get_status(client)
    if status.get("state") != "idle" or active_profile(status) is not None:
        raise ManagerError("Tun Auto Redirect is OFF, but Throne is not idle. Start was stopped to avoid changing settings during an active connection.")

    if bool(status.get("tun")):
        log("Tun Auto Redirect is OFF. TUN will first be disabled while no profile is active so the new setting can take effect from a clean state.", "WARN")
        off = client.command(["tun", "off"], timeout=90)
        if off.returncode != 0:
            raise ManagerError("Failed to disable TUN to apply Auto Redirect; the Kill Switch and profile were not changed.\n" + off.stdout.strip())
        deadline = time.monotonic() + 20
        while time.monotonic() < deadline:
            if not bool(get_status(client).get("tun")):
                break
            time.sleep(1)
        if bool(get_status(client).get("tun")):
            raise ManagerError("Throne did not confirm that TUN was disabled; Auto Redirect was not changed.")

    log("Tun Auto Redirect was OFF; enabling it for correct TUN routing on Linux.", "WARN")
    result = client.command(["settings", "set", "tun_auto_redirect=true"], timeout=60)
    if result.returncode != 0 and "editing" in result.stdout.lower():
        if sys.stdin.isatty():
            log("The Throne Settings window is open. Close it, then press Enter to retry the setting change.", "WARN")
            input("Have you closed Settings? Press Enter to continue: ")
            result = client.command(["settings", "set", "tun_auto_redirect=true"], timeout=60)
    if result.returncode != 0:
        raise ManagerError(
            "Failed to enable Tun Auto Redirect. Close the Settings window and run Start again.\n" + result.stdout.strip()
        )
    verified = get_settings(client)
    if not bool(verified.get("tun_auto_redirect")):
        raise ManagerError("Throne did not report tun_auto_redirect as enabled after the change; the connection was not started.")
    log("Tun Auto Redirect is now ON and was verified before enabling TUN.")


def start_with_candidates(client: ThroneClient, group_id: int, config: dict[str, Any], iface: str) -> tuple[dict[str, Any], dict[str, Any], bool]:
    settings = get_settings(client)
    status = get_status(client)
    if bool(settings.get("kill_switch")) or str(status.get("kill_switch", "off")).lower() not in ("off", ""):
        raise ManagerError("Kill Switch is already ON, but no connection is active. Run vpn-manager --stop first to restore normal networking; the application will not disable Kill Switch automatically.")

    # A stale desktop proxy can block direct update requests when no profile is
    # running. Clear it before the new session; Stop always normalizes it too.
    if bool(status.get("system_proxy")):
        proxy_result = client.command(["proxy", "off"], timeout=90)
        if proxy_result.returncode != 0:
            raise ManagerError("System Proxy remained enabled from the previous session and could not be disabled before starting a new connection.\n" + proxy_result.stdout.strip())

    # Linux TUN requires Auto Redirect so system traffic is actually captured.
    # Ensure it while no profile is running and before Kill Switch is armed.
    ensure_linux_auto_redirect(client)

    # Cache DNS answers before TUN/Kill Switch are enabled. This lets the
    # post-connect TUN probe bypass a broken system resolver with curl --resolve.
    resolve_endpoints_before_vpn()
    dns_over_tls_detected = diagnose_linux_dns()
    if dns_over_tls_detected:
        log("DNSOverTLS is enabled; during connection setup, it will be overridden only for the TUN interface.", "WARN")

    update_ok, _ = update_subscriptions(client)
    if not update_ok:
        log("Continuing with the current profile list; the subscription update error will remain in the final report.", "WARN")

    test_latency(client, group_id, int(config.get("latency_timeout_minutes", 20) or 20))
    profiles = get_profiles(client, group_id)
    candidates = profile_candidates(profiles, int(config.get("max_profile_attempts", 20) or 20))
    if not candidates:
        raise ManagerError("This group contains no usable fixed profiles. Auto Selectors are intentionally excluded so the server cannot change during your session.")
    candidates = test_ip_and_filter(client, group_id, candidates)
    # A single speed sample keeps data use bounded; IP Test has already
    # screened candidates for a real outbound IP.
    candidates = test_speed_and_rank(
        client, group_id, candidates, min(1, max(0, int(config.get("speed_test_top_n", 1) or 0)))
    )

    # Prepare TUN while no VPN profile is running. After benchmarking, arm
    # Kill Switch before the first handshake so ordinary system traffic cannot
    # escape while Throne establishes the selected connection. ThroneCore's
    # own VPN-server connections are allowed by the official Kill Switch design.
    tun_was_on = bool(get_status(client).get("tun"))
    tun_result = client.command(["tun", "on"], timeout=90) if not tun_was_on else None
    if tun_result and tun_result.returncode != 0:
        raise ManagerError("Failed to enable TUN.\n" + tun_result.stdout.strip())
    if not bool(get_status(client).get("tun")):
        raise ManagerError("Throne did not confirm that TUN was enabled.")

    # The candidate pool is already tested. Arm the guard before the first
    # handshake so a slow or pending connection cannot expose direct traffic.
    try:
        activate_kill_switch(client)
    except ManagerError:
        if not tun_was_on:
            client.command(["tun", "off"], timeout=90)
        try:
            set_kill_switch(client, False)
        except ManagerError:
            pass
        raise

    last_failure = ""
    for index, candidate in enumerate(candidates, 1):
        pid = int(candidate["id"])
        name = str(candidate.get("name", f"Profile {pid}"))
        latency = int(candidate.get("latency_ms", 0) or 0)
        latency_label = f"{latency} ms" if latency > 0 else "No valid result"
        log(f"Starting connection attempt [{index}/{len(candidates)}]: {name} | latency={latency_label}")
        result = client.command(["--timeout", "3m", "connect", str(pid)], timeout=CONNECT_TIMEOUT)
        outcome, running, state = wait_for_profile_result(client, pid, timeout=12)

        if outcome == "running" and running:
            actual_id = int(running.get("id", -1))
            # The moment any profile reaches RUNNING, pin it. Never attempt another.
            save_pin(running, phase="bootstrap-pinned", group_id=group_id)
            if actual_id != pid:
                log(f"Throne reported a different active profile (requested {pid}, active {actual_id}). The active connection will be preserved; no switch will be attempted.", "WARN")
            else:
                log(f"Profile connected and session pinned: {name} (ID {pid})")
            return running, state, update_ok

        if outcome == "pending":
            pending_profile = {"id": pid, "name": name, "type": candidate.get("type", "unknown")}
            save_pin(pending_profile, phase="connecting-pending", group_id=group_id)
            try:
                activate_kill_switch(client)
            except ManagerError as exc:
                log(f"Warning: Kill Switch could not be enabled for the pending connection: {exc}", "ERROR")
            raise ManagerError(f"Connection state for {name} has not reached a final state. No other profile will be tried to prevent an unintended switch. Check Throne; run vpn-manager --stop to end the session safely.\n{result.stdout.strip()}")

        # Retry during startup only after a continuously stable IDLE state.
        # A transient IDLE or an ambiguous command result must never trigger a
        # second connection attempt.
        stable_idle = wait_stably_idle(client, timeout=25, stable_seconds=4)
        if stable_idle is None:
            pending_profile = {"id": pid, "name": name, "type": candidate.get("type", "unknown")}
            save_pin(pending_profile, phase="connection-state-uncertain", group_id=group_id)
            raise ManagerError(
                f"Connection state for {name} is ambiguous, and Throne did not remain idle for four consecutive seconds. "
                "No other candidate will be tried to prevent a second VPN connection. "
                "Check the Throne state. Run vpn-manager --stop to end the session safely."
            )
        if result.returncode == 0:
            pending_profile = {"id": pid, "name": name, "type": candidate.get("type", "unknown")}
            save_pin(pending_profile, phase="connect-command-accepted-but-idle", group_id=group_id)
            raise ManagerError(
                f"The connect command for {name} returned a successful exit code, but Throne is still idle. "
                "No other candidate will be tried to prevent a second connection. Check the Throne state first, then run --stop."
            )
        last_failure = result.stdout.strip() or f"connect returned {result.returncode}"
        log(f"{name} did not reach RUNNING, and Throne remained idle for four consecutive seconds; this startup attempt failed. {last_failure}", "WARN")

    # All attempts failed before any profile became RUNNING. The guard may
    # now be safely removed because Throne is confirmed idle.
    idle_status = wait_status_idle(client, timeout=20)
    if idle_status.get("state") == "idle" and active_profile(idle_status) is None:
        if not tun_was_on:
            tun_off = client.command(["tun", "off"], timeout=90)
            if tun_off.returncode != 0:
                raise ManagerError("All profiles failed before connecting, and TUN could not be disabled. Do not turn off Kill Switch manually; run vpn-manager --stop to recover.")
        try:
            set_kill_switch(client, False)
        except ManagerError as exc:
            raise ManagerError(f"All profiles failed before connecting, but Kill Switch could not be disabled: {exc}. Run vpn-manager --stop to recover.")
        deadline = time.monotonic() + 25
        final_status: dict[str, Any] = {}
        while time.monotonic() < deadline:
            final_status = get_status(client)
            if str(final_status.get("kill_switch", "unknown")).lower() == "off":
                break
            time.sleep(1)
        if str(final_status.get("kill_switch", "unknown")).lower() != "off":
            raise ManagerError("All profiles failed before connecting, but Kill Switch being disabled could not be verified. Network access may remain blocked; run vpn-manager --stop.")
        if not tun_was_on and bool(final_status.get("tun")):
            raise ManagerError("Kill Switch is OFF, but TUN is still ON despite the recovery attempt. Run vpn-manager --stop.")
    else:
        raise ManagerError("Connection failed, but Throne is not idle. Kill Switch will remain enabled to prevent traffic leaks. Use --stop to recover.")
    raise ManagerError("No profile reached RUNNING. No active connection was established, and no profile was switched after a successful connection. Last error: " + last_failure)


def verify_pinned_session(client: ThroneClient, pinned_id: int, iface: str, proxy_url: str | None) -> str:
    profile, status = profile_running_now(client)
    if not profile or str(status.get("state")) != "running":
        raise ManagerError("The recorded connection is no longer RUNNING. VPN Manager will not replace the profile; run --stop to return to normal operation.")
    actual_id = int(profile.get("id", -1))
    if actual_id != pinned_id:
        raise ManagerError(f"The active profile ID changed from {pinned_id} to {actual_id}. VPN Manager did not initiate this switch; it may have been changed in Throne or by another tool. Run --stop to end the session.")

    # The TUN adapter may appear a few seconds after Throne reports RUNNING.
    # Wait for the actual Linux link instead of failing immediately.
    link_deadline = time.monotonic() + 35
    while time.monotonic() < link_deadline and not tun_interface_up(iface):
        current_profile, current_status = profile_running_now(client)
        if (not current_profile or int(current_profile.get("id", -1)) != pinned_id
                or current_status.get("state") != "running"):
            raise ManagerError("The profile changed or left RUNNING while TUN was being prepared; no replacement connection will be started.")
        time.sleep(1)
    if not tun_interface_up(iface):
        raise ManagerError(f"Profile {pinned_id} is active in Throne, but interface {iface} did not become UP within 35 seconds. No other profile will be tried.")

    # On Debian/systemd-resolved, DNS-over-TLS on the TUN link is a documented
    # cause of DNS failures. Set it to 'no' only on Throne's TUN link; do not
    # modify the global resolver configuration.
    dns_setting_applied = configure_tun_dns(iface)
    if DNS_OVER_TLS_DETECTED and dns_setting_applied:
        refresh_tun_same_profile_for_dns(client, pinned_id, iface)
    ip = public_ip(
        proxy_url, client=client, pinned_id=pinned_id, iface=iface,
        wait_seconds=90, grace_seconds=12,
    )
    if not ip:
        raise ManagerError(
            f"Profile {pinned_id} is active and pinned, but obtaining a public IP through the direct system/TUN route failed even after waiting and using pre-resolved DNS. "
            "No switch will be attempted; the session and Kill Switch will remain unchanged. "
            "Most likely areas to investigate: Tun Auto Redirect, DNS over TLS in systemd-resolved, and Remote/Direct DNS in Throne. "
            "All attempts are recorded in the log. To retry this same profile, run vpn-manager --start again; "
            "the application will recheck the pinned profile and will not select another server."
        )
    return ip


def start_session(client: ThroneClient, config: dict[str, Any], group_id: int | None) -> None:
    section("Start VPN session with a pinned profile")
    iface = str(config.get("tun_interface") or DEFAULT_TUN_IFACE)
    proxy_url = str(config.get("local_proxy_url") or DEFAULT_LOCAL_PROXY_URL).strip() or None
    existing_session = read_session()
    if existing_session:
        pinned = int(existing_session.get("profile_id", -1))
        profile, status = profile_running_now(client)
        if profile and int(profile.get("id", -1)) == pinned and status.get("state") == "running":
            log(f"A session is already active: {existing_session.get('profile_name')} (ID {pinned}).")
            log("Single-VPN policy: connection setup, profile tests, and subscription updates will not be repeated.")
            log(f"TUN: {'ON' if status.get('tun') else 'OFF'} | Kill Switch: {status.get('kill_switch', 'unknown')}")
            if not bool(status.get("tun")) or str(status.get("kill_switch", "")).lower() != "armed":
                raise ManagerError("The pinned profile is active, but TUN or Kill Switch is not in the expected state. No changes were made to avoid restarting the connection; run --stop only to end the session.")
            log("The session is already pinned. Only network and timezone verification for the same profile will be repeated. No selection tests or profile switches will occur.")
            if (existing_session.get("phase") == "bootstrap-pinned"
                    and not existing_session.get("tun_dns_refreshed")):
                diagnose_linux_dns()
            iface = str(config.get("tun_interface") or DEFAULT_TUN_IFACE)
            proxy_url = str(config.get("local_proxy_url") or DEFAULT_LOCAL_PROXY_URL).strip() or None
            ip = verify_pinned_session(client, pinned, iface, proxy_url)
            provider, country, city, zone = sync_timezone(ip, proxy_url)
            mark_session_verified()
            finish_report(profile, ip, provider, country, city, zone, subscription_updated=False, reused=True)
            return
        raise ManagerError("A previous session file exists, but the pinned profile is no longer active or its ID has changed. Start was stopped to prevent another VPN from being selected; run vpn-manager --stop first.")

    settings = get_settings(client)
    status = get_status(client)
    active = active_profile(status)

    if active and status.get("state") == "running":
        pid = int(active["id"])
        ptype = profile_type_by_id(client, pid, active)
        if is_dynamic_selector(ptype):
            raise ManagerError(f"The active profile “{active.get('name', pid)}” is an Auto Selector and may change servers automatically. To guarantee a fixed server, disconnect it with vpn-manager --stop before running Start.")
        if not bool(status.get("tun")):
            raise ManagerError(f"A VPN is already active ({active.get('name', pid)}), but TUN is OFF. To avoid restarting and interrupting the existing connection, no changes were made. Run --stop, then Start to create a new session with TUN enabled.")
        if not bool(settings.get("kill_switch")) or str(status.get("kill_switch", "off")).lower() != "armed":
            raise ManagerError(
                f"A profile is already active ({active.get('name', pid)}), but Kill Switch is not already armed. "
                "Kill Switch was left unchanged to avoid restarting the existing connection. "
                "Run vpn-manager --stop first, then Start."
            )
        # If the user already connected manually, capture the original timezone
        # only after all safety checks; never mutate a live connection's modes.
        original = ensure_original_timezone()
        log(f"Saved original timezone: {original}")
        save_pin(active, phase="pinned-existing", group_id=None)
        log(f"Existing connection accepted and pinned: {active.get('name', pid)} (ID {pid}). No other profile will be selected.")
        # Kill Switch is already armed; do not toggle it on a running profile,
        # because Linux may restart Throne's core when its setting changes.
        ip = verify_pinned_session(client, pid, iface, proxy_url)
        provider, country, city, zone = sync_timezone(ip, proxy_url)
        mark_session_verified()
        finish_report(active, ip, provider, country, city, zone, subscription_updated=False, reused=True)
        return

    if status.get("state") != "idle" or active is not None:
        raise ManagerError(f"Throne is in state {status.get('state')}; no other profile will be started until the current operation finishes.")

    if bool(settings.get("kill_switch")) or str(status.get("kill_switch", "off")).lower() not in ("off", ""):
        raise ManagerError("Kill Switch is ON, but no profile is active. Run vpn-manager --stop first to restore networking before starting a clean session.")

    original = ensure_original_timezone()
    log(f"Saved original timezone: {original}")
    if group_id is None:
        group_id = choose_group(client, config, force=True)
    profile, connect_status, update_ok = start_with_candidates(client, group_id, config, iface)
    pinned_id = int(profile["id"])

    # From this point the profile is immutable for this session.
    if read_session() is None:
        save_pin(profile, phase="pinned", group_id=group_id)
    ensure_tun_on(client, pinned_id, iface)
    activate_kill_switch(client)
    ip = verify_pinned_session(client, pinned_id, iface, proxy_url)
    provider, country, city, zone = sync_timezone(ip, proxy_url)

    current_profile, final_status = profile_running_now(client)
    if not current_profile or int(current_profile.get("id", -1)) != pinned_id or final_status.get("state") != "running":
        raise ManagerError("The profile ID does not match the pinned ID during final verification. No replacement was made; end the connection with --stop.")
    if str(final_status.get("kill_switch", "")).lower() != "armed":
        raise ManagerError("The profile is pinned, but Kill Switch is not armed. No profile switch will be attempted.")
    mark_session_verified()
    finish_report(profile, ip, provider, country, city, zone, subscription_updated=update_ok, reused=False)


def finish_report(profile: dict[str, Any], ip: str, provider: str, country: str,
                  city: str, zone: str, subscription_updated: bool | None, reused: bool) -> None:
    section("Session report")
    log("Status: VPN is connected and pinned to a single profile.")
    log(f"Profile: {profile.get('name', 'Unknown')} (ID {profile.get('id')})")
    log(f"Public IP: {ip}")
    log(f"Location: {city}, {country}")
    log(f"Timezone: {zone} (provider: {provider})")
    log("TUN: ON | Kill Switch: ARMED")
    if subscription_updated is True:
        log("Subscription Update: completed before connecting")
    elif subscription_updated is False:
        log("Subscription Update: skipped because a VPN was already active")
    else:
        log("Subscription Update: attempted before connecting; see log for its result")
    log("VPN switching during this session: DISABLED")
    log("To end the session and restore the system to its normal state: vpn-manager --stop")


def stop_session(client: ThroneClient | None) -> int:
    section("Stop session and restore normal system state")
    errors: list[str] = []
    original_zone = ensure_original_timezone_is_saved_for_stop()
    if not original_zone:
        errors.append("The saved original timezone is unavailable. Network cleanup will proceed, but the timezone cannot be restored.")
    network_ok = client is not None
    status: dict[str, Any] | None = None

    if client is not None:
        try:
            status = get_status(client)
            profile = active_profile(status)
            if profile or status.get("state") in ("connecting", "running", "stopping"):
                log(f"Disconnecting Throne (profile ID: {profile.get('id') if profile else 'transitioning'}) ...")
                result = client.command(["--timeout", "3m", "disconnect"], timeout=CONNECT_TIMEOUT)
                if result.returncode != 0:
                    log(result.stdout.strip() or "The disconnect command failed.", "WARN")
            status = wait_status_idle(client, timeout=35)
            if status.get("state") != "idle" or active_profile(status) is not None:
                errors.append("Throne did not return to idle after disconnect; TUN and Kill Switch were left unchanged to prevent traffic leaks.")
                network_ok = False
            else:
                log("VPN disconnected.")
                tun_result = client.command(["tun", "off"], timeout=90)
                proxy_result = client.command(["proxy", "off"], timeout=90)
                status = get_status(client)
                modes_off = not bool(status.get("tun")) and not bool(status.get("system_proxy"))
                if not modes_off:
                    detail = []
                    if bool(status.get("tun")):
                        detail.append("TUN is still enabled: " + tun_result.stdout.strip())
                    if bool(status.get("system_proxy")):
                        detail.append("System Proxy is still enabled: " + proxy_result.stdout.strip())
                    errors.append(
                        f"TUN/System Proxy were not fully disabled (tun={status.get('tun')}, system_proxy={status.get('system_proxy')}). "
                        + " | ".join(detail) + " Kill Switch will remain enabled."
                    )
                    network_ok = False
                else:
                    settings = get_settings(client)
                    if bool(settings.get("kill_switch")):
                        # The setting change is verified below against both the
                        # runtime state and the persisted setting.
                        client.command(["settings", "set", "kill_switch=false"], timeout=90)
                    deadline = time.monotonic() + 35
                    while time.monotonic() < deadline:
                        status = get_status(client)
                        settings = get_settings(client)
                        if (str(status.get("kill_switch", "unknown")).lower() == "off"
                                and not bool(settings.get("kill_switch"))):
                            break
                        time.sleep(1)
                    runtime_off = str(status.get("kill_switch", "unknown")).lower() == "off"
                    setting_off = not bool(settings.get("kill_switch"))
                    if not runtime_off or not setting_off:
                        errors.append(
                            f"Kill Switch shutdown was not verified (runtime={status.get('kill_switch')}, "
                            f"setting={settings.get('kill_switch')}, error={status.get('kill_switch_error')})."
                        )
                        network_ok = False
                    else:
                        log("TUN: OFF | System Proxy: OFF | Kill Switch: OFF")
        except Exception as exc:
            errors.append(f"Throne communication/control failed: {exc}")
            network_ok = False
    else:
        errors.append("The Throne API is unavailable; VPN disconnection and Kill Switch shutdown could not be performed through the API.")

    # Timezone is independent of the network cleanup, so attempt it even if the
    # API is unavailable. The network guard is intentionally left fail-closed
    # whenever the disconnect/mode cleanup could not be verified.
    if original_zone:
        try:
            if not restore_original_timezone(required=False):
                errors.append("Original timezone restoration did not complete.")
        except Exception as exc:
            errors.append(f"Failed to restore the original timezone: {exc}")

    if network_ok:
        try:
            clear_session()
            log("Network session state cleared.")
        except ManagerError as exc:
            errors.append(str(exc))
    else:
        log("The session file was retained because network cleanup was incomplete, allowing the remaining state to be tracked.", "WARN")

    if errors:
        section("Partial shutdown — manual review required")
        for item in errors:
            log("- " + item, "ERROR")
        log("Check the current status: vpn-manager --status")
        return 1
    section("System successfully restored to normal state")
    log("VPN: DISCONNECTED")
    log("TUN: OFF")
    log("System Proxy: OFF")
    log("Kill Switch: OFF")
    if original_zone:
        log(f"Timezone: {original_zone}")
    return 0


def show_status(client: ThroneClient, config: dict[str, Any]) -> None:
    section("Current VPN Manager / Throne status")
    status = get_status(client)
    settings = get_settings(client)
    profile = active_profile(status)
    session = read_session()
    log(f"Throne state: {status.get('state', 'unknown')}")
    log(f"Active profile: {profile.get('name')} (ID {profile.get('id')})" if profile else "Active profile: none")
    if session:
        log(f"Pinned session: {session.get('profile_name')} (ID {session.get('profile_id')}) | phase={session.get('phase')}")
        if profile and int(profile.get("id", -1)) != int(session.get("profile_id", -2)):
            log("WARNING: active profile differs from the session pin. Manager will not switch or reconnect.", "WARN")
    else:
        log("Pinned session: none")
    log(f"TUN mode: {'ON' if status.get('tun') else 'OFF'}")
    log(f"Tun Auto Redirect: {'ON' if settings.get('tun_auto_redirect') else 'OFF / unknown'}")
    log(f"System Proxy: {'ON' if status.get('system_proxy') else 'OFF'}")
    log(f"Kill Switch setting: {'ON' if settings.get('kill_switch') else 'OFF'}")
    log(f"Kill Switch runtime: {status.get('kill_switch', 'unknown')}")
    if status.get("kill_switch_error"):
        log(f"Kill Switch error: {status.get('kill_switch_error')}", "WARN")
    iface = str(config.get("tun_interface") or DEFAULT_TUN_IFACE)
    log(f"TUN interface {iface}: {'UP' if tun_interface_up(iface) else 'DOWN / absent'}")
    log(f"System timezone: {timedatectl_timezone()}")
    log(f"Original timezone: {ORIGINAL_TZ_FILE.read_text(encoding='utf-8').strip() if ORIGINAL_TZ_FILE.is_file() else 'not saved'}")
    log(f"Log: {LOG_FILE}")


def choose_group_guarded(client: ThroneClient, config: dict[str, Any]) -> None:
    status = get_status(client)
    if active_profile(status) or status.get("state") != "idle" or read_session():
        raise ManagerError("The subscription group cannot be changed during an active session. Run vpn-manager --stop first.")
    choose_group(client, config, force=True)


def print_recovery_hint() -> None:
    log("\nRecovery instructions:", "WARN")
    log("To view status: vpn-manager --status", "WARN")
    log("To disconnect the VPN, disable TUN/System Proxy/Kill Switch, and restore the original timezone: vpn-manager --stop", "WARN")
    log("If the API is unavailable, do not disable Kill Switch blindly; check the connection state in Throne first.", "WARN")


def acquire_lock() -> Any:
    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    handle = LOCK_FILE.open("a+")
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        raise ManagerError("Another instance of VPN Manager is already running.")
    return handle


def main() -> int:
    allowed = {"--start", "--run", "--stop", "--reset", "--status", "--choose-group", "--reset-timezone", "--version", "--help", "-h"}
    args = sys.argv[1:]
    if len(args) > 1 or any(arg not in allowed for arg in args):
        print("Usage: vpn-manager [--start | --stop | --status | --choose-group | --reset-timezone | --version]")
        return 2
    if args and args[0] == "--version":
        print(f"{APP} {VERSION}")
        return 0
    if args and args[0] in ("--help", "-h"):
        print("""vpn-manager
  --start, --run    Start a pinned single-profile VPN session
  --stop, --reset   Disconnect VPN, turn TUN/proxy/Kill Switch off, restore original timezone
  --status          Show Throne and pinned-session status
  --choose-group    Select the subscription group used for a future session
  --reset-timezone  Restore only the original timezone
  --version         Show installed version""")
        return 0

    if os.geteuid() == 0:
        print("Run vpn-manager as your normal desktop user, not with sudo.", file=sys.stderr)
        return 2
    init_dirs()
    lock = None
    try:
        lock = acquire_lock()
        log(f"{APP} {VERSION} started. Log: {LOG_FILE}")
        command = args[0] if args else None

        if command in ("--stop", "--reset"):
            if shutil.which("thronectl") is None:
                client = None
            else:
                try:
                    client = ThroneClient(allow_key_prompt=False)
                    api_health(client)
                except Exception as exc:
                    log(f"API is not ready: {exc}", "WARN")
                    client = None
            return stop_session(client)

        if command == "--reset-timezone":
            return 0 if restore_original_timezone(required=False) else 1

        if shutil.which("thronectl") is None:
            raise ManagerError("thronectl is not installed. Install the official Throne Linux package or a compatible binary.")
        client = ThroneClient()
        api_health(client)
        config = load_config()

        if command == "--status":
            show_status(client, config)
            return 0
        if command == "--choose-group":
            choose_group_guarded(client, config)
            return 0

        if command in ("--start", "--run"):
            start_session(client, config, config.get("group_id"))
            return 0

        # Interactive menu: one explicit Start or Stop action per invocation.
        choice = choose_menu("VPN Manager — Single VPN Session", [
            "Start VPN session (pin one profile)",
            "Stop VPN and restore normal system state",
            "Show status",
            "Choose subscription group",
            "Exit",
        ])
        if choice == 0:
            start_session(client, config, config.get("group_id"))
        elif choice == 1:
            return stop_session(client)
        elif choice == 2:
            show_status(client, config)
        elif choice == 3:
            choose_group_guarded(client, config)
        else:
            log("Exit.")
        return 0

    except KeyboardInterrupt:
        log("\nOperation interrupted by the user. VPN and Kill Switch states were intentionally left unchanged.", "WARN")
        print_recovery_hint()
        return 130
    except ManagerError as exc:
        log(f"Error: {exc}", "ERROR")
        print_recovery_hint()
        log(f"Log file: {LOG_FILE}")
        return 1
    except Exception as exc:
        log(f"Unexpected error: {type(exc).__name__}: {exc}", "ERROR")
        print_recovery_hint()
        log(f"Log file: {LOG_FILE}")
        return 1
    finally:
        if lock is not None:
            lock.close()


if __name__ == "__main__":
    raise SystemExit(main())
