def country_label(code: str) -> str:
    return COUNTRY_LABELS.get(code, code)


def is_anthropic_supported_egress(country_value: Any) -> tuple[bool, str, str]:
    """Return (allowed, ISO alpha-2 code, reason) using the official allowlist."""
    code = str(country_value or "").strip().upper()
    if not re.fullmatch(r"[A-Z]{2}", code):
        return False, code, "country code missing or invalid; region cannot be verified"
    if code in COUNTRIES_WITH_UNVERIFIABLE_REGIONAL_EXCLUSIONS:
        return False, code, (
            "Ukraine is conservatively excluded because Throne reports country-level data only "
            "and cannot distinguish the regions excluded by Anthropic's policy"
        )
    if code in ANTHROPIC_SUPPORTED_COUNTRY_CODES or code in ANTHROPIC_SUPPORTED_TERRITORY_CODES:
        return True, code, "listed as a supported country/territory by Anthropic"
    return False, code, "not present in Anthropic's Supported Regions allowlist"


def _job_results_from_cli(output: str) -> list[dict[str, Any]]:
    """Read the finished Throne IP-test Job; never trust stale profile fields."""
    try:
        payload = json.loads(output)
    except json.JSONDecodeError as exc:
        raise ManagerError(
            "Throne's IP Test did not return machine-readable Job data. "
            "The country filter cannot safely use cached profile results."
        ) from exc
    if isinstance(payload, dict) and isinstance(payload.get("job"), dict):
        payload = payload["job"]
    if not isinstance(payload, dict) or payload.get("kind") != "ip":
        raise ManagerError("Throne's IP Test response is not a valid IP-test Job.")
    if payload.get("state") != "done":
        raise ManagerError(f"Throne's IP Test did not finish successfully (state={payload.get('state')!r}).")
    results = payload.get("results")
    if not isinstance(results, list):
        raise ManagerError("Throne's IP Test Job has no per-profile results; cached country data will not be trusted.")
    return [item for item in results if isinstance(item, dict)]


def test_ip_and_filter(client: ThroneClient, group_id: int, candidates: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Test actual egress IP/country and allow only Anthropic-supported regions."""
    section("Verify egress IP and filter unsupported regions")
    ids = [int(p["id"]) for p in candidates if p.get("id") is not None]
    if not ids:
        raise ManagerError("No profiles are available for IP testing.")
    log(
        "Running Throne's native per-profile IP test. Candidate eligibility is based on the tested egress IP country, "
        "not the profile name, flag, or server hostname."
    )
    log(
        "Region policy: Anthropic Supported Regions Policy effective 2026-11-12. "
        "Countries/territories outside the official supported list, and unknown countries, are rejected."
    )
    result = client.command(
        ["--timeout", "5m", "test", "ip", *[str(x) for x in ids]],
        timeout=335, json_output=True, show_output=False,
    )
    if result.returncode != 0:
        log("Throne's built-in IP test did not complete: " + result.stdout.strip()[-300:], "WARN")
        raise ManagerError(
            "Throne could not complete the per-profile IP test. No connection was started because the actual exit country "
            "cannot be verified. Check Throne's IP Test and logs."
        )

    tested_profiles = _job_results_from_cli(result.stdout)
    by_id = {int(p.get("id", -1)): p for p in tested_profiles if p.get("id") is not None}
    candidate_by_id = {int(p["id"]): p for p in candidates if p.get("id") is not None}
    eligible: list[dict[str, Any]] = []
    rejected: list[str] = []

    for pid in ids:
        tested = by_id.get(pid)
        original = candidate_by_id.get(pid, {})
        name = str((tested or original).get("name", f"Profile {pid}"))
        if tested is None:
            reason = "no result returned by this IP-test Job"
            log(f"REJECTED: ID {pid} | {name} | {reason}", "WARN")
            rejected.append(f"{name} (ID {pid}: {reason})")
            continue

        raw_ip = str(tested.get("ip_out", "")).strip()
        valid_ip = _parse_global_ip(raw_ip)
        if not valid_ip:
            reason = "IP Test did not return a valid public egress IP"
            log(f"REJECTED: ID {pid} | {name} | {reason}", "WARN")
            rejected.append(f"{name} (ID {pid}: {reason})")
            continue

        allowed, country_code, reason = is_anthropic_supported_egress(tested.get("country"))
        tested_country = country_label(country_code) if country_code else "Unknown"
        if not allowed:
            log(
                f"REJECTED: ID {pid} | {name} | egress={valid_ip} | country={tested_country} "
                f"({country_code or 'NO CODE'}) | {reason}",
                "WARN",
            )
            rejected.append(f"{name} (ID {pid}: {tested_country} / {country_code or 'unknown'})")
            continue

        merged = dict(original)
        merged.update(tested)
        merged["ip_out"] = valid_ip
        merged["country"] = country_code
        eligible.append(merged)
        log(
            f"ELIGIBLE: ID {pid} | {name} | egress={valid_ip} | "
            f"country={tested_country} ({country_code})"
        )

    log(f"Region filter result: {len(eligible)} eligible, {len(rejected)} rejected out of {len(ids)} tested profile(s).")
    if rejected:
        for item in rejected:
            log(f"Excluded profile: {item}", "WARN")
    if not eligible:
        raise ManagerError(
            "No eligible profiles remain. Every candidate either had no verifiable egress country/IP or its egress region "
            "was not on Anthropic's Supported Regions allowlist. No VPN profile was connected and Kill Switch was not enabled."
        )
    return eligible


def test_speed_and_rank(client: ThroneClient, group_id: int, candidates: list[dict[str, Any]], top_n: int) -> list[dict[str, Any]]:
    """Benchmark a small pre-session pool; never changes the active connection."""
    if top_n <= 0 or not candidates:
        return candidates
    pool = [p for p in candidates if int(p.get("latency_ms", 0) or 0) > 0][:top_n]
    if not pool:
        pool = candidates[:top_n]
    ids = [int(p["id"]) for p in pool]
    log(f"Pre-session download speed test on {len(ids)} candidate(s): {', '.join(map(str, ids))}")
    result = client.command(
        ["--timeout", "15m", "test", "speed", *[str(x) for x in ids]],
        timeout=950, json_output=True, show_output=False,
    )
    refreshed = get_profiles(client, group_id)
    by_id = {int(p.get("id", -1)): p for p in refreshed if p.get("id") is not None}
    updated = [by_id.get(int(p["id"]), p) for p in candidates]
    measured = [p for p in updated if int(p.get("id", -1)) in set(ids)
                and int(p.get("download_bps", 0) or 0) > 0]
    if result.returncode == 0 and measured:
        measured.sort(key=lambda p: int(p.get("download_bps", 0) or 0), reverse=True)
        measured_ids = {int(p["id"]) for p in measured}
        remaining = [p for p in updated if int(p.get("id", -1)) not in measured_ids]
        best = measured[0]
        log(f"Best pre-test speed: {int(best.get('download_bps', 0)) / 1_000_000:.2f} Mbps | {best.get('name', 'Unknown')}")
        return measured + remaining
    log("Speed test returned no usable result; ranking by latency was retained.", "WARN")
    if result.stdout.strip():
        log(result.stdout.strip(), "WARN")
    return updated


