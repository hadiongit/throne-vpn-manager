def diagnose_linux_dns() -> bool:
    """Inspect systemd-resolved before TUN; return whether DNS-over-TLS is enabled."""
    global DNS_OVER_TLS_DETECTED
    DNS_OVER_TLS_DETECTED = False
    if shutil.which("resolvectl") is None:
        log("resolvectl is not installed; systemd-resolved diagnostics were skipped.", "WARN")
        return False
    result = run_cmd(["resolvectl", "status"], timeout=8, show_output=False)
    if result.returncode != 0:
        log("Could not read the systemd-resolved status; DNS settings will not be guessed.", "WARN")
        return False
    dot_lines = [line.strip() for line in result.stdout.splitlines() if "DNSOverTLS" in line]
    for line in dot_lines[:8]:
        log("systemd-resolved: " + line)
    enabled = any(
        re.search(r"DNSOverTLS(?:\s+setting)?:\s*yes", line, re.IGNORECASE)
        for line in dot_lines
    )
    DNS_OVER_TLS_DETECTED = enabled
    if enabled:
        log(
            "DNS over TLS is enabled on one of the links. Throne documentation notes that global DNSOverTLS in systemd-resolved can interfere with DNS over the Linux TUN interface; "
            "after throne-tun is created, the application will set DNSOverTLS to no only for that interface and test again.",
            "WARN",
        )
    return enabled


def run_privileged_interactive(argv: list[str], *, timeout: int = 45) -> int:
    """Run a sudo command with inherited terminal so its password prompt is visible."""
    log("Running system command: " + " ".join(argv))
    try:
        result = subprocess.run(["sudo", *argv], timeout=timeout, check=False)
        log(f"System command exited with code {result.returncode}.")
        return result.returncode
    except subprocess.TimeoutExpired:
        log("The system command timed out.", "WARN")
        return 124
    except FileNotFoundError:
        log("sudo or a required command could not be found.", "WARN")
        return 127


def configure_tun_dns(iface: str) -> bool:
    """Apply Throne's documented systemd-resolved workaround to the TUN link only."""
    if not shutil.which("resolvectl"):
        log("resolvectl is unavailable; system DNS settings will not be changed automatically.", "WARN")
        return False

    deadline = time.monotonic() + 35
    while time.monotonic() < deadline and not tun_interface_up(iface):
        time.sleep(1)
    if not tun_interface_up(iface):
        log(f"Interface {iface} did not become UP within 35 seconds after connecting; interface DNS cannot be configured.", "WARN")
        return False

    log(f"TUN interface ({iface}) is ready; disabling DNSOverTLS only for this interface.")
    rc = run_privileged_interactive(["resolvectl", "dnsovertls", iface, "no"], timeout=35)
    if rc != 0:
        log(
            f"Could not apply DNSOverTLS settings to {iface}. This setting affects only the TUN interface; "
            "global systemd-resolved settings were not changed.",
            "WARN",
        )
        return False

    # Clear negative/stale resolver cache entries after changing the per-link policy.
    if shutil.which("resolvectl"):
        run_cmd(["resolvectl", "flush-caches"], timeout=10, show_output=False)
    time.sleep(2)
    log(f"DNSOverTLS for interface {iface} was set to no; the DNS cache was also flushed.")
    return True


def refresh_tun_same_profile_for_dns(client: ThroneClient, pinned_id: int, iface: str) -> None:
    """Reapply a per-link DNS policy once during bootstrap, without changing profile ID."""
    session = read_session() or {}
    if session.get("tun_dns_refreshed"):
        return
    if session.get("phase") not in ("bootstrap-pinned", "connecting-pending"):
        log("The session is already established; TUN will not be restarted to avoid interrupting your work.", "WARN")
        return

    profile, status = profile_running_now(client)
    if (not profile or int(profile.get("id", -1)) != pinned_id
            or status.get("state") != "running"
            or str(status.get("kill_switch", "")).lower() != "armed"):
        raise ManagerError("The pinned profile or Kill Switch was not in a safe state before applying the DNS fix; no other profile will be started.")

    log("DNSOverTLS was enabled in systemd-resolved. To apply the documented setting, TUN will be restarted once during this initial setup only. The profile ID will remain unchanged and Kill Switch will stay enabled.", "WARN")
    off = client.command(["tun", "off"], timeout=90)
    if off.returncode != 0:
        raise ManagerError("The one-time TUN restart required for the DNS fix did not start. The profile and Kill Switch remain unchanged.\n" + off.stdout.strip())

    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        current_profile, current_status = profile_running_now(client)
        if current_profile and int(current_profile.get("id", -1)) != pinned_id:
            raise ManagerError("The profile ID changed while applying DNS settings; VPN Manager will not start another profile.")
        if (current_profile and int(current_profile.get("id", -1)) == pinned_id
                and current_status.get("state") == "running"
                and not bool(current_status.get("tun"))):
            break
        time.sleep(1)
    else:
        raise ManagerError("Throne did not confirm that TUN was disabled for the DNS update. Kill Switch remains enabled.")

    on = client.command(["tun", "on"], timeout=90)
    if on.returncode != 0:
        raise ManagerError("TUN could not be re-enabled after the DNS fix. Kill Switch remains enabled; run --stop for controlled recovery.\n" + on.stdout.strip())

    deadline = time.monotonic() + 120
    while time.monotonic() < deadline:
        current_profile, current_status = profile_running_now(client)
        if current_profile and int(current_profile.get("id", -1)) != pinned_id:
            raise ManagerError("After TUN was re-enabled, Throne reported a different profile; no further switching will be attempted.")
        if (current_profile and int(current_profile.get("id", -1)) == pinned_id
                and current_status.get("state") == "running"
                and bool(current_status.get("tun")) and tun_interface_up(iface)):
            break
        time.sleep(1)
    else:
        raise ManagerError("The pinned profile did not return to running with TUN ON under the same ID after the TUN restart. Kill Switch remains enabled; run --stop to recover.")

    # The interface may have been recreated; apply the per-link setting again.
    if not configure_tun_dns(iface):
        raise ManagerError("TUN was re-enabled, but the interface DNS settings could not be verified after recreation. Kill Switch remains enabled; run --stop to recover.")
    session = read_session() or {}
    session["tun_dns_refreshed"] = True
    write_session(session)
    log(f"TUN is ready again with the same profile {pinned_id}; the DNS fix was applied and verified.")


